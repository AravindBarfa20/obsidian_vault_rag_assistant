# ---- Gemini ----------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# When empty, the app runs in OFFLINE MODE using a deterministic fake embedder
# and fake LLM so you can develop and run tests without credentials.
GEMINI_API_KEY=

# Models (current, generally-available)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini-3.7-flash
LLM_TEMPERATURE=0.0

# ---- Vault -----------------------------------------------------------------
# Directory containing your Obsidian Markdown notes.
VAULT_DIR=./sample_vault

# ---- Chunking --------------------------------------------------------------
CHUNK_SIZE=1400
CHUNK_OVERLAP=200

# ---- Vector store ----------------------------------------------------------
CHROMA_DIR=./.chroma
COLLECTION_NAME=obsidian_vault

# ---- Retrieval -------------------------------------------------------------
TOP_K=6
# Leave blank to use the active provider's calibrated default.
RELEVANCE_THRESHOLD=
MAX_CHUNKS_PER_NOTE=3

# ---- App -------------------------------------------------------------------
LOG_LEVEL=INFO
